<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Remotes -->
  <remote  name="haloui-devices"
           fetch="https://github.com/HaloUI-Devices"
           revision="seventeen" />

  <remote  name="codeberg"
           fetch="https://codeberg.org/zenin1504"
           revision="seventeen" />

  <remote  name="haloui"
           fetch="https://github.com/HaloUI-AOSP"
           revision="seventeen" />

<!-- Remove -->
<remove-project path="build/make" />
<remove-project path="bootable/recovery" />
<remove-project path="device/lineage/sepolicy" />
<remove-project path="external/bouncycastle" />
<remove-project path="external/wpa_supplicant_8" />
<remove-project path="frameworks/base" />
<remove-project path="frameworks/native" />
<remove-project path="lineage-sdk" />
<remove-project path="packages/apps/Backgrounds" />
<remove-project path="packages/apps/Launcher3" />
<remove-project path="packages/apps/LineageParts" />
<remove-project path="packages/apps/Settings" />
<remove-project path="packages/apps/Updater" />
<remove-project path="system/core" />
<remove-project path="system/fs/fs_mgr" />
<remove-project path="system/sepolicy" />
<remove-project path="system/update_engine" />
<remove-project path="vendor/lineage" />
<remove-project path="hardware/qcom-caf/sm8750/audio/pal" />
<remove-project path="hardware/qcom-caf/sm8750/audio/primary-hal" />
<remove-project path="vendor/qcom/opensource/commonsys/audio" />

<!-- Apps -->
<project path="packages/apps/Backgrounds" name="android_packages_apps_Backgrounds" remote="haloui" />
<project path="packages/apps/GameSpace" name="android_packages_apps_GameSpace" remote="haloui" />
<project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3" remote="haloui" groups="pdk-fs,sysui-studio,pdk-cw-tvc" />
<project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="haloui" />
<project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="haloui" groups="pdk-fs,pdk-cw-tvc,sysui-studio" />
<project path="packages/apps/Updater" name="android_packages_apps_Updater" remote="haloui" />

<!-- Build -->
  <project path="build/make" name="android_build_make" groups="pdk,sysui-studio" remote="haloui" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

<!-- External -->
  <project path="external/wpa_supplicant_8" name="android_external_wpa_supplicant_8" groups="pdk" remote="haloui" />
  <project path="external/bouncycastle" name="android_external_bouncycastle" groups="pdk" remote="haloui" />


<!-- Frameworks -->
<project name="android_frameworks_base" path="frameworks/base" remote="haloui" groups="pdk-cw-fs,pdk-fs,sysui-studio" />
<project name="android_frameworks_native" path="frameworks/native" remote="haloui" groups="pdk,sysui-studio"  />

<!-- System -->
<project path="bootable/recovery" name="android_bootable_recovery" remote="haloui" groups="pdk" />
<project path="system/core" remote="haloui" name="android_system_core" groups="pdk" />
<project path="system/fs/fs_mgr" remote="haloui" name="android_system_fs_fs_mgr" groups="pdk" />
<project path="system/sepolicy" name="android_system_sepolicy" remote="haloui" groups="pdk" />
<project path="system/update_engine" name="android_system_update_engine" remote="haloui" groups="pdk" />

<!-- Vendor -->
<project name="android_vendor_lineage" path="vendor/lineage" remote="haloui" />
<project name="android_vendor_haloui" path="vendor/haloui" remote="haloui" />
<project name="official_devices" path="vendor/official_devices" remote="haloui" revision="master" />

<!-- Misc -->
<project path="device/lineage/sepolicy" name="LineageOS/android_device_lineage_sepolicy" />
<project name="android_vendor_microg" path="vendor/microg" remote="haloui" />
<project name="android_vendor_gapps" path="vendor/gapps" remote="haloui" />
<project name="android_hardware_xiaomi" path="hardware/xiaomi" remote="haloui" />
<project path="lineage-sdk" name="android_lineage-sdk"  remote="haloui" />

</manifest>
